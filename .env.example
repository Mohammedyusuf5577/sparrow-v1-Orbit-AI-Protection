# ============================================================
# ORBIT AI Protection - Backend Environment Configuration
# ============================================================
# Provide these as environment variables, OR copy the secret ones into
# src/main/resources/application-local.properties (gitignored) using the
# property names from application.properties.

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgresql_v1_orbit_co_in
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here

# JWT Configuration (use a long random string, 32+ chars)
JWT_SECRET=replace_with_a_long_random_secret_for_hs256
JWT_EXPIRATION=86400000

# Encryption (AES key: use 16, 24 or 32 characters)
ENCRYPTION_SECRET=replace_with_32_char_encryption_key

# Meta WhatsApp Cloud API Configuration
# Get from Meta Developers Portal -> WhatsApp -> API Setup
WHATSAPP_TOKEN=your_permanent_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_API_VERSION=v19.0
WHATSAPP_TEMPLATE_NAME=project_assignment
WHATSAPP_TEMPLATE_LANG=en

# Outbox Scheduler Configuration (Poll interval in milliseconds)
APP_OUTBOX_SCHEDULER_RATE=30000

# Razorpay Configuration (from Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_ACCOUNT_NUMBER=your_razorpay_x_account_number
