{
  "name": "ORBIT Stage (backend + portal + PostgreSQL)",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "forwardPorts": [3000, 8080],
  "portsAttributes": {
    "3000": { "label": "ORBIT Admin Portal (stage UI)", "onAutoForward": "openBrowserOnce" },
    "8080": { "label": "ORBIT API + Swagger (stage)", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "customizations": {
    "vscode": { "extensions": ["vscjava.vscode-java-pack"] }
  }
}
